{
    "manifest_version": 3,
    "name": "Site Marker",
    "version": "2.0.0",
    "description": "Mark sites as dev/test/staging with a visible badge to avoid confusion when managing multiple environments.",
    "minimum_chrome_version": "102",
    "homepage_url": "https://github.com/laukatu/Site-Marker",
    "icons": {
        "16": "images/logo16.png",
        "32": "images/logo32.png",
        "48": "images/logo48.png",
        "128": "images/logo128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Site Marker: manage markers"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage",
        "scripting"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ]
}
